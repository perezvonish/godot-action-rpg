[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/player_menu/inventory/inventory_tab.gd" id="1"]

[node name="InventoryTab" type="MarginContainer"]
script = ExtResource("1")
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="Content" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Bag" type="VBoxContainer" parent="Content"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Capacity" type="Label" parent="Content/Bag"]
unique_name_in_owner = true
layout_mode = 2
text = "0 / 30 ячеек"

[node name="Grid" type="GridContainer" parent="Content/Bag"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6
columns = 10

[node name="EmptyHint" type="Label" parent="Content/Bag"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.64, 0.68, 0.74, 1)
text = "Инвентарь пока пуст."

[node name="Separator" type="VSeparator" parent="Content"]
layout_mode = 2

[node name="Details" type="VBoxContainer" parent="Content"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
theme_override_constants/separation = 12

[node name="ItemIcon" type="TextureRect" parent="Content/Details"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="ItemTitle" type="Label" parent="Content/Details"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Выберите предмет"
autowrap_mode = 3

[node name="DescriptionScroll" type="ScrollContainer" parent="Content/Details"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="ItemDescription" type="Label" parent="Content/Details/DescriptionScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.72, 0.76, 0.82, 1)
text = "Здесь появится его описание."
autowrap_mode = 3

[node name="ItemQuantity" type="Label" parent="Content/Details"]
unique_name_in_owner = true
layout_mode = 2
